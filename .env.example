# Copy to .env (or set these in your hosting dashboard)

# Port the server listens on (hosting platforms usually set this for you)
PORT=3000

# Password for the host/admin screen. CHANGE THIS before the event.
HOST_PASSWORD=change-me-diwali

# The public address people use to open the app, used in personal links and QR codes.
# Example: https://ps-diwali-tambola.onrender.com
# Leave empty when testing on your laptop; the app then uses the address you opened it with.
PUBLIC_URL=

# Where the game is saved so a server restart doesn't lose anything
DATA_DIR=./data
